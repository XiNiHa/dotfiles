#!/usr/bin/env nu

let hostname = open /etc/hostname
let timeout = if $hostname =~ "PC" {
  300
} else {
  120
}

(
	swayidle -w timeout $timeout 'hyprctl dispatch "hl.dsp.dpms(off)"'
              resume 'hyprctl dispatch "hl.dsp.dpms(on)"'
              timeout ($timeout * 2) 'systemctl suspend'
)
